
<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:design="http://flowable.org/design" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://flowable.org/test" exporter="Flowable Design" exporterVersion="2026.1.3" design:palette="flowable-work-process-palette">
  <collaboration id="Collaboration">
    <participant id="Pool_7" name="Peluditos Pet Chile" processRef="peluditosPetChileASIS"></participant>
  </collaboration>
  <process id="peluditosPetChileASIS" name="Peluditos Pet Chile - AS-IS" isExecutable="true" flowable:candidateStarterGroups="flowableUser">
    <documentation>Modelo BPMN AS-IS que representa el proceso actual de gestión de consultas de Peluditos Pet Chile.

Las consultas se reciben principalmente a través de redes sociales y WhatsApp, siendo atendidas manualmente por una persona responsable del emprendimiento.

El seguimiento de los potenciales clientes se realiza de manera irregular y no existe un registro centralizado de los resultados comerciales, lo que dificulta el control y la trazabilidad de las oportunidades de venta.</documentation>
    <extensionElements>
      <flowable:candidates-type><![CDATA[all]]></flowable:candidates-type>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-10-22T00:13:12.817Z]]></design:creationdate>
      <design:description><![CDATA[Modelo BPMN AS-IS que representa el proceso actual de gestión de consultas de Peluditos Pet Chile.

Las consultas se reciben principalmente a través de redes sociales y WhatsApp, siendo atendidas manualmente por una persona responsable del emprendimiento.

El seguimiento de los potenciales clientes se realiza de manera irregular y no existe un registro centralizado de los resultados comerciales, lo que dificulta el control y la trazabilidad de las oportunidades de venta.]]></design:description>
      <design:modificationdate><![CDATA[2026-10-22T01:11:32.312Z]]></design:modificationdate>
    </extensionElements>
    <laneSet id="laneSet_peluditosPetChileASIS">
      <lane id="Lane_8" name="Responsable del emprendimiento">
        <flowNodeRef>ExpandedSubProcess_14</flowNodeRef>
        <flowNodeRef>ExpandedSubProcess_11</flowNodeRef>
        <flowNodeRef>ExpandedSubProcess_9</flowNodeRef>
        <flowNodeRef>Exclusive_Databased_Gateway_13</flowNodeRef>
        <flowNodeRef>StartNoneEvent_6</flowNodeRef>
        <flowNodeRef>EndNoneEvent_17</flowNodeRef>
        <flowNodeRef>SequenceFlow_19</flowNodeRef>
        <flowNodeRef>SequenceFlow_15</flowNodeRef>
        <flowNodeRef>SequenceFlow_12</flowNodeRef>
        <flowNodeRef>SequenceFlow_18</flowNodeRef>
        <flowNodeRef>SequenceFlow_17</flowNodeRef>
        <flowNodeRef>SequenceFlow_10</flowNodeRef>
      </lane>
    </laneSet>
    <subProcess id="ExpandedSubProcess_14" name="Realizar seguimiento">
      <extensionElements>
        <design:stencilid><![CDATA[ExpandedSubProcess]]></design:stencilid>
      </extensionElements>
    </subProcess>
    <subProcess id="ExpandedSubProcess_11" name="Responder consulta manualmente">
      <extensionElements>
        <design:stencilid><![CDATA[ExpandedSubProcess]]></design:stencilid>
      </extensionElements>
    </subProcess>
    <subProcess id="ExpandedSubProcess_9" name="Revisar consulta recibida">
      <extensionElements>
        <design:stencilid><![CDATA[ExpandedSubProcess]]></design:stencilid>
      </extensionElements>
    </subProcess>
    <exclusiveGateway id="Exclusive_Databased_Gateway_13" name="¿Se realiza seguimiento?" default="SequenceFlow_18">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <startEvent id="StartNoneEvent_6" name="Consulta recibida" flowable:initiator="initiator" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:work-form-field-validation><![CDATA[false]]></flowable:work-form-field-validation>
        <design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </startEvent>
    <endEvent id="EndNoneEvent_17" name="Atencion finalizada">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExpandedSubProcess_14" targetRef="EndNoneEvent_17">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExpandedSubProcess_11" targetRef="Exclusive_Databased_Gateway_13">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExpandedSubProcess_9" targetRef="ExpandedSubProcess_11">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_18" name="No" sourceRef="Exclusive_Databased_Gateway_13" targetRef="EndNoneEvent_17">
      <extensionElements>
        <flowable:is-default-flow><![CDATA[true]]></flowable:is-default-flow>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_17" name="Si" sourceRef="Exclusive_Databased_Gateway_13" targetRef="ExpandedSubProcess_14">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${realizarSeguimiento == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_10" sourceRef="StartNoneEvent_6" targetRef="ExpandedSubProcess_9">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
  </process>
